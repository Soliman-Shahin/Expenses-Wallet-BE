PORT=port_number
SECRET_KEY=secret_key
MONGO_URI=mongodb_url
JWT_SECRET=your_jwt_secret_key_here
ACCESS_TOKEN_SECRET=your_access_token_secret_here_REQUIRED
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here_REQUIRED
JWT_EXPIRES_IN=30d
REFRESH_TOKEN_EXPIRY_DAYS=10

ENCRYPTION_KEY=your_encryption_key_here_REQUIRED

# Password Hashing
SALT_ROUNDS=10

# OAuth
GOOGLE_CLIENT_ID=your_google_client_id_here_REQUIRED
GOOGLE_CLIENT_SECRET=your_google_client_secret_here_REQUIRED
GOOGLE_CALLBACK_URL=/v1/user/auth/google/callback
FACEBOOK_APP_ID=your_facebook_app_id_here_REQUIRED
FACEBOOK_APP_SECRET=your_facebook_app_secret_here_REQUIRED
FACEBOOK_CALLBACK_URL=http://localhost:3000/v1/user/auth/facebook/callback
MOBILE_OAUTH_REDIRECT=expenseswallet://auth
FRONTEND_URL=http://localhost:4200

# Server
APP_URL=http://localhost:${PORT}
NODE_ENV=development

# CORS
ALLOWED_ORIGINS=http://localhost:4200,http://localhost:8100,http://localhost:4300